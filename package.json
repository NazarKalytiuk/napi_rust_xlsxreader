{
  "name": "@nazarkalytiuk/rusc-xlsx-reader",
  "version": "1.0.1",
  "description": "Fast, memory-bounded XLSX reader for Node.js powered by Calamine and NAPI-RS",
  "main": "wrapper.js",
  "module": "wrapper.mjs",
  "types": "wrapper.d.ts",
  "exports": {
    ".": {
      "types": "./wrapper.d.ts",
      "import": "./wrapper.mjs",
      "require": "./wrapper.js",
      "default": "./wrapper.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazarKalytiuk/napi_rust_xlsxreader.git"
  },
  "homepage": "https://github.com/NazarKalytiuk/napi_rust_xlsxreader#readme",
  "bugs": {
    "url": "https://github.com/NazarKalytiuk/napi_rust_xlsxreader/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "napi": {
    "binaryName": "rusc_xlsx_reader",
    "targets": [
      "universal-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ],
    "darwin": {
      "universal": {
        "targets": [
          "x86_64-apple-darwin",
          "aarch64-apple-darwin"
        ]
      }
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "check": "cargo fmt -- --check && cargo clippy --all-targets -- -D warnings && cargo test --lib && npm run test:types",
    "benchmark": "node --expose-gc benchmarks/compare-reading.js",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "clean": "cargo clean && rm -rf *.node npm",
    "prepublishOnly": "napi prepublish -t npm",
    "release:check": "node scripts/check-release.js",
    "release:verify-artifacts": "node scripts/verify-artifacts.js",
    "release:verify-published": "node scripts/verify-published.js",
    "test": "node --test tests/*.test.js",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "universal": "napi universalize",
    "version": "napi version"
  },
  "keywords": [
    "xlsx",
    "xlsm",
    "excel",
    "spreadsheet",
    "reader",
    "streaming",
    "etl",
    "rust",
    "napi-rs"
  ],
  "author": "Nazarii Kalytiuk <nazarkwork@gmail.com>",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "wrapper.js",
    "wrapper.mjs",
    "wrapper.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@nazarkalytiuk/rusc-xlsx": "^2.0.0",
    "@types/node": "^24.19.2",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
